    OEKG:has_full_name "Centralized and decentral approaches succeed the 100% energiewende in Germany in the European context - A model-based analysis of generation, network, and storage investments" ;
    OEKG:has_publication <http://openenergy-platform.org/ontology/oekg/publication/c6367f2f-5929-6e1e-36d6-f12ae4a023c6> ;
