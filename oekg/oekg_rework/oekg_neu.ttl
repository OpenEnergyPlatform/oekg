OEKG:0bbb21b8-d233-2963-7976-aa18ce8b0382 a OEO:OEO_00010252 ;
    OEKG:has_full_name "Speed of technological transformations required in Europe to achieve different climate goals" ;
    OEKG:has_publication <http://openenergy-platform.org/ontology/oekg/publication/77ea039e-fe67-a3d4-ce34-3cea054a1681> ;
    OEKG:has_scenario <http://openenergy-platform.org/ontology/oekg/scenario/0b99ae06-0733-e095-e321-455c4287920c>,
