<http://openenergy-platform.org/ontology/oekg/scenario/fa1532b9-fb42-bb8a-9c10-1ae7e6e033a0> a OEO:OEO_00000365 ;
    RDFS:label "DSZ-grid" ;
    OEKG:has_full_name "DSZ Grid Operation" ;
    OEKG:scenario_uuid "fa1532b9-fb42-bb8a-9c10-1ae7e6e033a0" ;
    OEO:OEO_00020222 <http://openenergy-platform.org/ontology/oekg/https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/Germany> ;
    OEO:has_scenario_descriptor OEO:OEO_00020411,
        OEO:OEO_00030010 ;
    DC:abstract "The scenario investigates the possibilities of coupled laboratory infrastructures for flexibilizing low-voltage electrical grids as a scalable platform in energy research. The objective is to test the platform in responding to grid instabilities, such as voltage drops, and evaluate the performance of different components, including battery storage systems and heat pumps, in providing flexibility to the grid. Using a combination of real-time simulators, virtual machines, and communication gateways to connect three geographically separated laboratories enables the users to utilize laboratory hardware of different energy sectors." .

