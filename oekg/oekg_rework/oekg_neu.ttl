<http://openenergy-platform.org/ontology/oekg/scenario/15304c1e-3ac2-3a3d-7b85-b282ccb5aa06> a OEO:OEO_00000365 ;
    RDFS:label "TN-H2-G" ;
    OEKG:has_full_name "TN-H2-G" ;
    OEKG:scenario_uuid "15304c1e-3ac2-3a3d-7b85-b282ccb5aa06" ;
    OEO:OEO_00020220 <http://openenergy-platform.org/ontology/oekg/region/Germany> ;
    OEO:OEO_00020224 "2030",
        "2040",
        "2050" ;
    OEO:has_scenario_descriptor OEO:OEO_00020247,
        OEO:OEO_00020317,
        OEO:OEO_00030009 ;
    DC:abstract "The scenario worlds based on hydrogen examine different forms of increased use of hydrogen for the decarbonization of the energy system. The TN-H2-G scenario presented here analyses a very strong use of hydrogen in the energy system. The coverage of energy demand is optimized. In the modeling of the energy supply, the demand for hydrogen must be provided by electrolysis in Germany, Europe or other regions of the world, similar to the TN-Strom scenario." .

