<http://openenergy-platform.org/ontology/oekg/scenario/c01e2802-97f2-aa0d-f8ce-ae1f19f9715f> a OEO:OEO_00000365 ;
    RDFS:label "GreenLate" ;
    OEKG:has_full_name "Germany - resource efficient and greenhouse gas neutral - Late transition" ;
    OEKG:scenario_uuid "c01e2802-97f2-aa0d-f8ce-ae1f19f9715f" ;
    OEO:OEO_00020220 <http://openenergy-platform.org/ontology/oekg/region/Germany> ;
    OEO:OEO_00020224 "2016",
        "2030",
        "2040",
        "2050" ;
    OEO:has_scenario_descriptor OEO:OEO_00020247,
        OEO:OEO_00020317,
        OEO:OEO_00030009 ;
    DC:abstract "GreenLate (\"Germany - resource efficient and greenhouse gas neutral - Late transition\"), outlines another possible transformation path for Germany as an export-oriented an export-orientated industrial location with a modern, efficient society. Due to the delayed increase in the level of ambition in the implementation of climate climate protection measures in the scenario, GreenLate illustrates the challenges that delayed action in achieving a GHG reduction of 95% by 2050. " .

<http://openenergy-platform.org/ontology/oekg/scenario/c3d5c505-f449-4f89-424b-3b01142528a6> a OEO:OEO_00000365 ;
