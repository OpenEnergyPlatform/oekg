OEKG:1b45437b-d42a-7406-33ae-b4767495535d a OEO:OEO_00010252 ;
    OEKG:has_full_name "Modeling all alternative solutions for highly renewable energy systems" ;
    OEKG:has_publication <http://openenergy-platform.org/ontology/oekg/publication/b51d0059-121c-ee16-9ae7-b449f68149d2> ;
    OEKG:has_scenario <http://openenergy-platform.org/ontology/oekg/scenario/04db836e-9571-8cf5-f4df-d07427e878b7>,
