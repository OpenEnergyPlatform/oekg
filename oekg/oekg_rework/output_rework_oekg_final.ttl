        OEO:OEO_00020321,
        OEO:OEO_00030009 ;
    OEO:OEO_00390095 "54a374e9-218b-fdbe-d843-b5ae43e9eb25"^^XSD:string .

<https://openenergyplatform.org/ontology/oekg/scenario/586b307d-6a0d-5b74-bc7a-827744091d27> a OEO:OEO_00000365 ;
    RDFS:label "REG"^^XSD:string ;
    DC:abstract "Relying on very strong intensification of energy and transport policies in absence of carbon pricing in road transport and buildings. In REG, maritime transport sector is included in the EU Emissions Trading System (ETS)."^^XSD:string ;
    DC:acronym "EU-Core-REG"^^XSD:string ;
