<https://openenergyplatform.org/ontology/oekg/scenario/a26612f3-9a69-371f-aca4-f70b2545ad2a> a OEO:OEO_00000365 ;
    RDFS:label "Climate Protection Instruments Scenario 2030 (BEHG-sensitivity)"^^XSD:string ;
    DC:abstract "A sensitivity calculation was used to determine which greenhouse gas emissions would result if the CO2 price of the Fuel Emissions Trading Act corresponded to the price path assumed in the 2021 projection report. Achievement of the climate protection goals for 2030 was therefore not assumed. Achieving the climate protection goals for 2030 is therefore not necessary.The existing instruments and their parameterization are the same as in the KIS-2030."^^XSD:string ;
    DC:acronym "KIS-2030 (BEHG-sensitivity)"^^XSD:string ;
    OEO:OEO_00020220 <https://openenergyplatform.org/ontology/oekg/region/Germany> ;
    OEO:OEO_00020440 "2025-01-01T00:00:00"^^XSD:dateTime,
