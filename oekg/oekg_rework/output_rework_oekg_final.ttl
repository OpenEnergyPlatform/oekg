<https://openenergyplatform.org/ontology/oekg/scenario/b1ad759c-bed8-066f-971e-878020a3946c> a OEO:OEO_00000365 ;
    RDFS:label "Germany - resource efficient and greenhouse gas neutral - Energy efficiency - 2"^^XSD:string ;
    DC:abstract "The two GreenEe scenarios stand for \"Germany - resource efficient and greenhouse gas neutral - Energy efficiency\" and focus on the development of energy efficiency potential across all areas of application. "^^XSD:string ;
    DC:acronym "GreenEe2"^^XSD:string ;
