<https://openenergyplatform.org/ontology/oekg/scenario/3fc42966-9510-7148-c6ed-a21f79a86636> a OEO:OEO_00000365 ;
    RDFS:label "Aktuelle-Maßnahmen-Szenario (2012)"^^XSD:string ;
    DC:abstract "In this scenario, all measures that were implemented in Germany until October 2012 are taken into account and are extrapolated to 2050. This scenario reflects the current status of energy an and climate policy framework. "^^XSD:string ;
    DC:acronym "AMS (2012)"^^XSD:string ;
