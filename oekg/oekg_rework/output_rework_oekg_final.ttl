<https://openenergyplatform.org/ontology/oekg/scenario/a6c11d2b-7f13-ea0f-48b7-8a2f996dea3c> a OEO:OEO_00000365 ;
    RDFS:label "Responsible Policy Scenario"^^XSD:string ;
    DC:abstract "The Responsible Policy Scenario is transformational and requires significant efforts to change practices in the building sector. It has been created by setting all EUCalc levers in the building module, the power module and the lifestyle module related to homes at Level 4. "^^XSD:string ;
    DC:acronym "BPIE-2030-Respon"^^XSD:string ;
