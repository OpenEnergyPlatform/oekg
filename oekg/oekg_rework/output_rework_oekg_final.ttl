        OEO:OEO_00140151,
        OEO:OEO_00360011,
        OEO:OEO_00360014 ;
    OEO:OEO_00390079 OEO:OEO_00010056 .

OEKG:bb79a385-9024-1554-47d2-ab016b3c4432 a OEO:OEO_00020227 ;
    RDFS:label "Long-term implications of reduced gas imports on the decarbonization of the European energy system"^^XSD:string ;
    OBO:BFO_0000051 <https://openenergyplatform.org/ontology/oekg/frameworks/163>,
        <https://openenergyplatform.org/ontology/oekg/models/224>,
        <https://openenergyplatform.org/ontology/oekg/publication/e0afd4ac-c5f8-ab0f-61f5-0421d7580c16>,
