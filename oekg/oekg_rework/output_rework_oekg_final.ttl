<https://openenergyplatform.org/ontology/oekg/scenario/93ae7805-a044-df2c-ae3b-2e9ce272032c> a OEO:OEO_00000365 ;
    RDFS:label "Ausgewogener Technologiemix"^^XSD:string ;
    DC:abstract "Utilisation of a mixed energy carrier portfolio (hydrogen, electrification and synthetic fuels) in final energy use"^^XSD:string ;
