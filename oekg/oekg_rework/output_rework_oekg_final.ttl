<https://openenergyplatform.org/ontology/oekg/scenario/2dd771cf-5ee7-6ac2-270c-0b08fa00c300> a OEO:OEO_00000365 ;
    RDFS:label "Germany  resource efficient and greenhouse gas neutral  Minimizing future GHG emissions and raw material consumption"^^XSD:string ;
    DC:abstract "Green Supreme stands for \"Germany - resource efficient and greenhouse gas neutral - Minimizing future GHG emissions and raw material consumption\". The possible change shown here has been characterized from the outset by a pronounced and ambitious joint understanding of the implementation of climate protection and resource conservation, decarbonization and consistent energy saving in Germany and internationally. Quickly integrated, polluter-pays framework conditions set the right incentives across all emission source areas at an early stage. This will achieve a significant reduction in greenhouse gases, particularly in the period up to 2040, and make a fundamental contribution to reducing cumulative emissions and meeting a 1.5 C transformation pathway according to the IPCC."^^XSD:string ;
    DC:acronym "GreenSupreme"^^XSD:string ;
    OEO:OEO_00020220 <https://openenergyplatform.org/ontology/oekg/region/Germany> ;
    OEO:OEO_00020440 "2016-01-01T00:00:00"^^XSD:dateTime,
        "2030-01-01T00:00:00"^^XSD:dateTime,
        "2040-01-01T00:00:00"^^XSD:dateTime,
        "2050-01-01T00:00:00"^^XSD:dateTime ;
    OEO:OEO_00390073 OEO:OEO_00020247,
        OEO:OEO_00020317,
        OEO:OEO_00030009 ;
    OEO:OEO_00390095 "2dd771cf-5ee7-6ac2-270c-0b08fa00c300"^^XSD:string .

<https://openenergyplatform.org/ontology/oekg/scenario/2e4abb2b-43f0-935c-babd-1976ae5a128e> a OEO:OEO_00000365 ;
    RDFS:label "Energiestrategie 2030"^^XSD:string ;
    DC:abstract "Demand data from 2010 is scaled with expected demand in 2030 (political goal) (more pre-processing described in study) "^^XSD:string ;
    DC:acronym "appBBB_ES2030"^^XSD:string ;
