<https://openenergyplatform.org/ontology/oekg/scenario/438ce4e0-1755-9819-2529-8e126b6e3e14> a OEO:OEO_00000365 ;
    RDFS:label "Hauptszenario Klimaneutralitt 100"^^XSD:string ;
    DC:abstract "The main scenario Climate Neutrality 100 (KN100) takes into account the sector targets for 2030 in accordance with the Climate Protection Act 2021 and achieves greenhouse gas neutrality in 2045. Existing legal requirements such as the Renewable Energy Sources Act or the National Hydrogen Strategy are included."^^XSD:string ;
    DC:acronym "KN100"^^XSD:string ;
    OEO:OEO_00020220 <https://openenergyplatform.org/ontology/oekg/region/Germany> ;
