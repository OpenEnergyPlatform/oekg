<https://openenergyplatform.org/ontology/oekg/scenario/a4665f7f-107e-1355-28fd-3a84414b2e99> a OEO:OEO_00000365 ;
    RDFS:label "Wasserstoff (Import)"^^XSD:string ;
    DC:abstract "Increased direct use of hydrogen in areas where direct electrification is difficult. Increased direct use of hydrogen in areas where direct electrification is difficult. Total import potential for RE-based energy sources of 350-580 TWh in 2045, of which 250-400 TWh hydrogen."^^XSD:string ;
    DC:acronym "H2-Imp"^^XSD:string ;
    OEO:OEO_00020220 <https://openenergyplatform.org/ontology/oekg/region/Germany> ;
