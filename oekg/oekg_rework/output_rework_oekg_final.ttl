<https://openenergyplatform.org/ontology/oekg/scenario/833c6665-73f6-6817-f534-4a10f5054a3a> a OEO:OEO_00000365 ;
    RDFS:label "Energiestrategie 2030 Grüne"^^XSD:string ;
    DC:abstract """Die offiziellen Annahmen zu Energieeinsparungen, Export und
Kraftwerkskapazitäten aus der Energiestrategie 2030 werden als unrealistisch angesehen. Deshalb
wird in einem zweiten Szenario mit veränderten Annahmen gerechnet."""^^XSD:string ;
    DC:acronym "appBBB_gruene2030"^^XSD:string ;
    OEO:OEO_00020437 <https://openenergyplatform.org/ontology/oekg/input_datasets/eafdff4a-a638-5a99-1019-afae867e88d7> ;
    OEO:OEO_00020440 "2030-01-01T00:00:00"^^XSD:dateTime ;
