        sh:resultMessage "Scenario target: This should end in class exogenous data.";        
    ] ;
    sh:property [
        sh:path oeo:RO_0002234 ; #has_output 
        sh:class oeo:OEO_00030030; #endogenous data
        sh:resultMessage "Scenario target: This should end in class endogenous data.";        
    ] ;
    sh:property [
        sh:path dc:abstract ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:resultMessage "Scenario target: This should be a string and have max one abstract.";
    ] .

