    a sh:NodeShape ;
    sh:targetObjectsOf oekg:has_scenario;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path dc:acronym ; 
        sh:datatype xsd:string ;
