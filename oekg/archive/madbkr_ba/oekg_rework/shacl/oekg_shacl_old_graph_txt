#Shape to validate publications
ex:PublicationShape
    a sh:NodeShape ;
    sh:targetObjectsOf oekg:has_publication;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property[
        sh:path oekg:link_to_study_report;
        sh:datatype xsd:string;
        sh:maxCount 1 ;
        sh:resultMessage "Publication target: This should be string and have max one link.";
    ];
    sh:property[
        sh:path oekg:publication_uuid; 
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string;
        sh:resultMessage "Publication target: This should be a string and have exactly one uuid.";
    ];
    sh:property [
        sh:path rdfs:label;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:resultMessage "Publication target: This should be a string and have exactly one label.";
    ] ;
    sh:property [
        sh:path oeo:OEO_00000506 ; #has_author
        sh:class oeo:OEO_00000064; #author
        sh:minCount 1 ;
        sh:resultMessage "Publication target: This should have at least one author.";
    ] ;
    sh:property [
        sh:path oekg:date_of_publication ;
        sh:datatype xsd:dateTime; 
        sh:resultMessage "Publication target: This should end in a date.";
    ] ;
    sh:property [
        sh:path oekg:report_title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; 
        sh:maxCount 1 ; 
        sh:resultMessage "Publication target: This should be a string and have exactly one title.";
    ];
     sh:property [
        sh:path oekg:doi ; 
        sh:datatype xsd:string;
        sh:maxCount 1 ;
        sh:resultMessage "Publication target: This should be a string and have max one doi.";
    ].

# Shape to validate scenario factsheets
