    <owl:DatatypeProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00140178">
        <rdfs:domain rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000350"/>
        <obo:IAO_0000115>Has number is a data property that links a quantity value to a number that defines the quantity value.</obo:IAO_0000115>
