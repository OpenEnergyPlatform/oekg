    <!-- https://www.commoncoreontologies.org/ont00001777 -->

    <owl:ObjectProperty rdf:about="https://www.commoncoreontologies.org/ont00001777">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
        <owl:inverseOf rdf:resource="https://www.commoncoreontologies.org/ont00001857"/>
        <rdfs:isDefinedBy rdf:resource="https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl"/>
        <rdfs:label xml:lang="en">has process part</rdfs:label>
        <skos:definition xml:lang="en">x has_process_part y iff x and y are instances of Process, such that y occurs during the temporal interval of x, and y either provides an input to x or receives an output of x, or both.</skos:definition>
        <OEO_00020426>issue https://github.com/OpenEnergyPlatform/ontology/issues/2014
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2016</OEO_00020426>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/ExtendedRelationOntology</www:ont00001760>
    </owl:ObjectProperty>
