pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006</OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410025 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410025">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00360020"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410026"/>
                    </owl:Restriction>
