    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://www.commoncoreontologies.org/ont00001942"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">prescribes</owl:annotatedTarget>
        <prov:wasDerivedFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.8.0/imports/cco-extracted.owl"/>
