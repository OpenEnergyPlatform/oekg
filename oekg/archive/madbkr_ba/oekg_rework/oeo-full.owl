    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00010042 -->

    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00010042">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000422"/>
        <rdf:type>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
