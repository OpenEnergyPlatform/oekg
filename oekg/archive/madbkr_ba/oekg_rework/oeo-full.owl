        <www:ont00001754 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Marriage&amp;oldid=1064076951</www:ont00001754>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/EventOntology</www:ont00001760>
    </owl:Class>
