        <obo:IAO_0000115 xml:lang="en">A water protection area is a protected area that has the water protection area role, i.e. it is aimed at safeguarding the quality and quantity of water resources, including surface water and groundwater.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Wasserschutzgebiet</obo:IAO_0000118>
        <rdfs:label xml:lang="en">water protection area</rdfs:label>
