    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00000182">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000395"/>
        <obo:IAO_0000115>The state of being a gas. A portion of matter is in gaseous state if and only if it has no definite shape and no definite volume and is not electrically conductive.</obo:IAO_0000115>
