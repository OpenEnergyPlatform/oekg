      (positively_regulates ?ei ?en2)  
      (MaterialEntity ?me) 
      (has_participant ?ed ?me) (has_participant ?ei ?me) 
      (inheres_in ?en1 ?me) (inheres_in ?en2 ?me) ))))</obo:IAO_0000602>
