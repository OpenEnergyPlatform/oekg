    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00020440 -->

    <owl:DatatypeProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00020440">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000365"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <obo:IAO_0000115>Has scenario year value is a relation between a scenario factsheet and a xsd:dateTime value.</obo:IAO_0000115>
        <rdfs:comment>This data property allows for comparable and sortable annotation of scenario years in the OEKG.</rdfs:comment>
        <rdfs:label xml:lang="en">has scenario year value</rdfs:label>
        <OEO_00020426>add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2035
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2045</OEO_00020426>
