        <skos:altLabel xml:lang="en">Oscillation</skos:altLabel>
        <skos:definition xml:lang="en">A Change in which the dependent entity alternates between two or more stases.</skos:definition>
        <www:ont00001754 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Oscillation&amp;oldid=1002978272</www:ont00001754>
