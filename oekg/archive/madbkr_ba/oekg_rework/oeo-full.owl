    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410023 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410023">
        <owl:equivalentClass>
            <owl:Class>
