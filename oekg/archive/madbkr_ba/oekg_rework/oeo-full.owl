    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410021 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410021">
        <owl:equivalentClass>
            <owl:Class>
