    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00390094 -->

    <owl:DatatypeProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00390094">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000310"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <obo:IAO_0000115>has iri is a relation between a data item or document and the IRI that identifies it as rescource on the internet.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has iri</rdfs:label>
        <OEO_00020426>add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020</OEO_00020426>
    </owl:DatatypeProperty>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00390095 -->

    <owl:DatatypeProperty rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00390095">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000088"/>
