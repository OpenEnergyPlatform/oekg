    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00010161 -->

    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00010161">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000367"/>
        <obo:BFO_0000050 rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00010057"/>
        <OEO_00000504 rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000242"/>
        <obo:IAO_0000115>The CRF sector (IPCC 2006) &apos;solid fuels&apos; is a sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories:
Includes all intentional and unintentional emissions from the extraction, processing, storage and transport of fuel to the point of final use.</obo:IAO_0000115>
        <obo:IAO_0000119>2006 IPCC Guidelines for National Greenhouse Gas Inventories, Volume 1, Chapter 8.5, https://www.ipcc-nggip.iges.or.jp/public/2006gl/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">CRF sector (IPCC 2006): solid fuels</rdfs:label>
