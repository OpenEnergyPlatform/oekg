    <!-- https://www.commoncoreontologies.org/ont00000895 -->

    <owl:Class rdf:about="https://www.commoncoreontologies.org/ont00000895">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000335"/>
        <rdfs:isDefinedBy rdf:resource="https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl"/>
        <rdfs:label xml:lang="en">Married</rdfs:label>
        <skos:altLabel xml:lang="en">Married Stasis</skos:altLabel>
        <skos:definition xml:lang="en">A Stasis of Generically Dependent Continuant that consists of a socially, culturally, or ritually recognized union or legal contract between spouses that establishes rights and obligations between them, between them and their children, and between them and their in-laws.</skos:definition>
