        <owl:differentFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000424"/>
        <obo:IAO_0000115>False is a boolean value which is intended to represent the truth value false (denoted by 0, by -, the falsum ⊥, or falsch (F) in German).</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">falsch</obo:IAO_0000118>
        <rdfs:label xml:lang="en">false</rdfs:label>
