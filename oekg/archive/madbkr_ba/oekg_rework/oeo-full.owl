        <obo:IAO_0000115>The European Union Emissions Trading System (EU ETS) is a policy instrument that implements an emissions trading system covering the European Union, Norway, Iceland and Liechtenstein.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">EU ETS</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="de">EU-EHS</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="de">Emissionshandelssystem der Europäischen Union</obo:IAO_0000118>
