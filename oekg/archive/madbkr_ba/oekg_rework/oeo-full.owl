        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00360020"/>
        <obo:IAO_0000115 xml:lang="en">A floodplain is a region of relevance that has the floodplain role, i.e. for areas between surface waters and dykes or high banks and other areas that are flooded or flowed through during flooding of a surface water body or that are used for flood relief or retention.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Überschwemmungsgebiet</obo:IAO_0000118>
        <rdfs:label xml:lang="en">floodplain</rdfs:label>
        <OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006</OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410024 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000504"/>
                <owl:hasValue rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A floodplain role is a role for areas between surface waters and dykes or high banks and other areas that are flooded or flowed through during flooding of a surface water body or that are used for flood relief or retention.</obo:IAO_0000115>
        <obo:IAO_0000119>See German water resources act: § 76 WHG: https://www.gesetze-im-internet.de/whg_2009/__76.html</obo:IAO_0000119>
        <rdfs:label xml:lang="en">floodplain role</rdfs:label>
