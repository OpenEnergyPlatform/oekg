        <rdfs:label xml:lang="en">Wounded Stasis</rdfs:label>
        <skos:altLabel xml:lang="en">Wounded</skos:altLabel>
        <skos:definition xml:lang="en">A Damaged Stasis in which a Person or other organism is the bearer of a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to an injuring event.</skos:definition>
