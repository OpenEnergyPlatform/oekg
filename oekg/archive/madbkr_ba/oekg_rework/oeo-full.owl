        <obo:IAO_0000115 xml:lang="en">A lithium-ion battery is a battery that is rechargeable and in which lithium ions move from the negative electrode to the positive electrode during discharge, and back when charging. Li-ion batteries use an intercalated lithium compound as one electrode material.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">LIB</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">Li-ion battery</obo:IAO_0000118>
