    <!-- https://www.commoncoreontologies.org/ont00000924 -->

    <owl:Class rdf:about="https://www.commoncoreontologies.org/ont00000924">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001191"/>
        <rdfs:comment xml:lang="en">A Beginning of Life Stasis (BoL) is a relatively brief Operational Stasis that is primarily of interest for the purpose of establishing a baseline for operational parameters to be compared to the designed specifications as well as the Artifact&apos;s performance throughout its operational life.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl"/>
        <rdfs:label xml:lang="en">Beginning of Life Stasis</rdfs:label>
        <skos:definition xml:lang="en">A Operational Stasis that holds during a Temporal Interval when an Artifact is first put into operational use such that its designed set of Artifact Functions is capable of operating at or near their designed peak performance levels.</skos:definition>
        <www:ont00001753>BOL</www:ont00001753>
        <www:ont00001753>BoL</www:ont00001753>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/EventOntology</www:ont00001760>
    </owl:Class>
