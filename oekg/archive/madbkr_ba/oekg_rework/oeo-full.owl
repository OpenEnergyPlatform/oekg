        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <prov:wasDerivedFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/releases/2.8.0/imports/cco-extracted.owl"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://www.commoncoreontologies.org/ont00000106"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
