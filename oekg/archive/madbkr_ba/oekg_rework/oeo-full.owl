            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00240022"/>
        <obo:IAO_0000115 xml:lang="en">A bird sanctuary is a protected area that has the bird sanctuary role, which is aimed at protecting and conserving endangered and migratory bird species, within the European &quot;Natura 2000&quot; network of protected areas.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Vogelschutzgebiet</obo:IAO_0000118>
        <rdfs:label xml:lang="en">bird sanctuary</rdfs:label>
        <OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1991</OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410017 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410017">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410013"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000504"/>
                <owl:hasValue rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410014"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A biosphere reserve role is a protected area role for areas, aimed at conserving biodiversity, promoting sustainable development, and supporting research and education, within the UNESCO &quot;Man and the Biosphere&quot; (MAB) Programme.</obo:IAO_0000115>
        <obo:IAO_0000119>See German nature conservation law: § 25 BNatSchG: https://www.gesetze-im-internet.de/bnatschg_2009/__25.html</obo:IAO_0000119>
        <rdfs:label xml:lang="en">biosphere reserve role</rdfs:label>
        <OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006</OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410018 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410018">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00240022"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410019"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00240022"/>
        <obo:IAO_0000115 xml:lang="en">A protected landscape area is a protected area that has the protected landscape area role, i.e. it is aimed at conserving and enhancing the natural and cultural landscape, while allowing for sustainable land use and recreational activities.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Landschaftsschutzgebiet</obo:IAO_0000118>
        <rdfs:label xml:lang="en">protected landscape area</rdfs:label>
        <OEO_00020426>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006</OEO_00020426>
    </owl:Class>
    


    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00410019 -->

    <owl:Class rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00410019">
        <rdfs:subClassOf rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00410013"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000504"/>
