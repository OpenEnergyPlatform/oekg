    <!-- https://openenergyplatform.org/ontology/oeo/OEO_00360044 -->

    <owl:NamedIndividual rdf:about="https://openenergyplatform.org/ontology/oeo/OEO_00360044">
        <rdf:type rdf:resource="https://openenergyplatform.org/ontology/oeo/OEO_00000368"/>
        <obo:IAO_0000115 xml:lang="en">The BSI-KritisV sector division is a sector division by the German regulation BSI-Kritisverordnung (BSI-KritisV) defining eight sectors that contain critical infrastructures.</obo:IAO_0000115>
