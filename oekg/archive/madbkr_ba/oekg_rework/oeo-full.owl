        <obo:IAO_0000115>Vehicle-kilometre is a transport performance unit for the accumulated transport distance of the used vehicles themselves where one vehicle-kilometre equals the transport distance of 1 km for one vehicle.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Fahrzeugkilometer</obo:IAO_0000118>
        <oboInOwl:hasExactSynonym>vkm</oboInOwl:hasExactSynonym>
