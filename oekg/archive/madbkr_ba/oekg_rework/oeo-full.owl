        <obo:IAO_0000115 xml:lang="en">A manufacturing plant is an artificial object that applies one or more manufacturing processes to produce one more kinds of manufactured materials.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">industrial plant</obo:IAO_0000118>
        <rdfs:label xml:lang="en">manufacturing plant</rdfs:label>
